@techreport{Lawson2024,
  title = "Shaping the future of generative {AI}: The impact of open source
           innovation",
  author = "Lawson, Adrienn and Hendrick, Stephen and Rausch, Nancy and Sica,
            Jeffrey and Gerosa, Marco",
  abstract = "LF AI \& Data and CNCF partnered with LF Research to answer the
              question: what is the role of open source in the evolution and
              implementation of generative AI (GenAI) technologies? Based on a
              survey of 316 professionals across diverse industries, this report
              shows how open source tools are accelerating GenAI adoption while
              setting a foundation for the future of AI. Key findings show that
              84\% of organizations have a moderate to high adoption of GenAI,
              and 41\% of that infrastructure is open source. Leading use cases
              include process automation, content generation, and code
              generation. What's more, 82\% of respondents agree that open source
              AI is critical for a positive AI future.",
  publisher = "The Linux Foundation",
  month = nov,
  year = 2024,
}

